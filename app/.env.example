# All variables are OPTIONAL. The app runs fully without any of them (offline demo mode).
#
# Preferred: leave the key empty and paste it into Settings in the running app.
# It is then stored only in that browser's localStorage.
#
# WARNING: anything in a VITE_ variable is embedded in the public JavaScript bundle.
# Only set VITE_ANTHROPIC_API_KEY for a private / password-protected demo deployment,
# with a key that has a low spend limit.
VITE_ANTHROPIC_API_KEY=

# Default Claude model for document extraction (can also be changed in Settings).
# claude-opus-5-5 (default) | claude-sonnet-5-5 | claude-haiku-4-5
VITE_CLAUDE_MODEL=claude-opus-5-5
